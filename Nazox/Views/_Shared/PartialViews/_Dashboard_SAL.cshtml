<!-- TAB11 - SALUD-->
<div id="tab11" class="tab-content">
    <h3>Salud</h3>
    <hr>

    <h4 class="mt-4">Indicadores de Acciones de Salud</h4>
    <div class="row my-3 mx-auto">
        <div class="col-md-3 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                    <p class="font-size-14 mb-2 card-text-wrap">Total de Brigadas</p>
                    <i data-feather="users" class="text-info mb-3" style="width: 36px; height: 36px;"></i>
                    <h3 class="mb-0 text-info card-text-wrap">45</h3>
                    <p class="text-muted small mt-2 card-text-wrap">Realizadas anualmente</p>
                </div>
            </div>
