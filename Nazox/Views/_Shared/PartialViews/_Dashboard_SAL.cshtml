                    <p class="font-size-14 mb-2 card-text-wrap">Total de Fumigaciones</p>
                    <i data-feather="cloud-off" class="text-primary mb-3" style="width: 36px; height: 36px;"></i>
                    <h3 class="mb-0 text-primary card-text-wrap">120</h3>
                    <p class="text-muted small mt-2 card-text-wrap">Eventos de control de plagas</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-4">Indicadores de Atenciones Médicas</h4>
    <div class="row my-3 mx-auto">
        <div class="col-md-3 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
